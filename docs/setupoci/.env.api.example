DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_MAX_CONNECTIONS=20

REDIS_URL=redis://redis:6379

R2_ACCESS_KEY_ID=ocid1.customersecret.oc1..exampleuniqueID
R2_SECRET_ACCESS_KEY=replace_with_customer_secret_value
R2_ENDPOINT=https://yournamespace.compat.objectstorage.us-ashburn-1.oci.customer-oci.com
R2_REGION=us-ashburn-1
R2_FORCE_PATH_STYLE=true
R2_BUCKET_NAME=through-your-letters
R2_PUBLIC_URL=https://yournamespace.compat.objectstorage.us-ashburn-1.oci.customer-oci.com/through-your-letters

JWT_SECRET=replace_with_minimum_32_char_random_secret
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash

CITY_DISCOVERY_USER_AGENT=through-your-letters/1.0 (admin@yourdomain.com)
HOST=0.0.0.0
PORT=3000
RUST_LOG=info

ENABLE_ML_PROCESSING=false
ML_MODEL_PATH=./models/text_detector.onnx
HUGGINGFACE_TOKEN=

ENABLE_VIRUS_SCAN=false
RATE_LIMIT_UPLOADS_PER_IP=100
ENABLE_PENDING_AUTO_APPROVE=true
PENDING_AUTO_APPROVE_MINUTES=30
PENDING_AUTO_APPROVE_INTERVAL_SECONDS=300
PENDING_AUTO_APPROVE_BATCH_SIZE=50
IGNORE_MISSING_MIGRATIONS=true
